{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["miniprogram/*"]
    },
    "types": ["wechat-miniprogram"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "miniprogram_npm", "dist"]
}

