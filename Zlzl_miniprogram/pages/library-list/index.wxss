.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}

.header,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.icon-action {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #111827;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 72rpx;
}

.state {
  margin-top: 32rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.library-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2ff;
  color: #3730a3;
  font-size: 22rpx;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.bar {
  display: flex;
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
}

.bar-green,
.bar-yellow,
.bar-gray {
  flex: 1;
}

.bar-green {
  background: #16a34a;
}

.bar-yellow {
  background: #f59e0b;
}

.bar-gray {
  background: #d1d5db;
}
