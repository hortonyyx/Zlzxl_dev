<view class="page">
  <text class="title">{{title}}</text>
  <text class="description">先支持前台录音 {{maxDurationText}}，云上传和 ASR 会在后续阶段接入。</text>

  <view class="record-panel">
    <view class="record-head">
      <text class="record-label">{{recording ? '录音中' : recordedFile ? '已完成录音' : '准备录音'}}</text>
      <text class="record-dot {{recording ? 'on' : ''}}">●</text>
    </view>
    <text class="timer">{{elapsedText}}</text>
    <view class="meter">
      <view class="meter-fill" style="width: {{progressPercent}}%;"></view>
    </view>
    <text class="hint">到 {{maxDurationText}} 会自动停止。本阶段录音只保存在本地临时文件。</text>

    <button wx:if="{{!recording}}" class="primary-action" bindtap="startRecording">开始录音</button>
    <button wx:else class="danger-action" loading="{{stopping}}" bindtap="stopRecording">结束课</button>

    <view wx:if="{{recordedFile}}" class="file-card">
      <text class="panel-title">本地录音文件</text>
      <text class="description">时长 {{recordedDurationText}} · 大小 {{recordedFileSizeText}}</text>
      <text class="path">{{recordedFile.tempFilePath}}</text>

      <view class="upload-card">
        <text class="panel-title">云存储上传</text>
        <block wx:if="{{uploading}}">
          <text class="description">上传中 {{uploadProgress}}%</text>
          <view class="meter upload-meter">
            <view class="meter-fill" style="width: {{uploadProgress}}%;"></view>
          </view>
        </block>
        <block wx:elif="{{uploadResult}}">
          <text class="description">上传完成</text>
          <text class="path">{{uploadResult.recordingFileId}}</text>
        </block>
        <block wx:elif="{{uploadError}}">
          <text class="error-text">{{uploadError}}</text>
          <button class="secondary-action upload-action" loading="{{uploading}}" bindtap="retryUploadRecording">重试上传</button>
        </block>
      </view>

      <button class="secondary-action" loading="{{submitting}}" bindtap="submitRecordedClass">{{uploadResult ? '用云录音进入 mock 处理' : '用录音占位进入 mock 处理'}}</button>
    </view>
  </view>

  <view class="fallback">
    <view class="fallback-head">
      <text class="panel-title">手动文本 fallback</text>
      <text class="fallback-badge">备用入口</text>
    </view>
    <text class="description">录音或真机能力不可用时，仍可用文本跑通课堂输出和测验。</text>
    <textarea class="textarea" value="{{content}}" bindinput="onContentInput" maxlength="-1" />
    <button class="secondary-action fallback-action" loading="{{submitting}}" bindtap="submitClass">提交文本生成总结</button>
  </view>
</view>
