.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f6f7f9;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.description {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.6;
}

.record-panel,
.fallback,
.file-card {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-label,
.panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.record-dot {
  color: #9ca3af;
  font-size: 28rpx;
}

.record-dot.on {
  color: #dc2626;
}

.timer {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
}

.meter {
  height: 12rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.meter-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #111827;
}

.hint,
.path {
  display: block;
  margin-top: 14rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.path {
  word-break: break-all;
}

.file-card {
  margin-top: 20rpx;
  background: #f9fafb;
}

.primary-action {
  border-radius: 12rpx;
  background: #111827;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-action,
.danger-action {
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.secondary-action {
  background: #e5e7eb;
  color: #111827;
}

.danger-action {
  background: #dc2626;
  color: #ffffff;
}
