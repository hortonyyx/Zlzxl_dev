<view class="page">
  <view wx:if="{{loading}}" class="description">加载中...</view>
  <block wx:else>
    <text class="title">{{title}}</text>
    <view class="panel">
      <text class="panel-title">完整总结</text>
      <text class="description">{{node.summary.full}}</text>
    </view>
    <view class="panel">
      <text class="panel-title">要点提炼</text>
      <text wx:for="{{node.summary.points}}" wx:key="*this" class="item">· {{item}}</text>
    </view>
    <view class="panel">
      <text class="panel-title">核心问题</text>
      <text wx:for="{{node.summary.coreQuestions}}" wx:key="*this" class="item">· {{item}}</text>
    </view>
    <view class="panel muted">完整转写稿 / 纠错入口占位</view>
    <button class="primary-action" bindtap="startQuiz">开始课后测验</button>
    <button class="secondary-action" bindtap="backToLibrary">回到脉络</button>
  </block>
</view>
