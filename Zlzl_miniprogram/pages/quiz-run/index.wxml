<view class="page">
  <view wx:if="{{loading}}" class="description">加载中...</view>
  <block wx:else>
    <text class="title">{{title}}</text>
    <view wx:for="{{questions}}" wx:key="_id" class="panel">
      <text class="panel-title">{{index + 1}}. {{item.prompt}}</text>
      <textarea
        class="answer"
        data-index="{{index}}"
        bindinput="onAnswerInput"
        placeholder="用自己的话作答"
      />
    </view>
    <button class="primary-action" loading="{{submitting}}" bindtap="submitQuiz">提交测验</button>
  </block>
</view>
