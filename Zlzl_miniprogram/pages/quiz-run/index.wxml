<view class="page">
  <view wx:if="{{loading}}" class="description">加载中...</view>
  <block wx:else>
    <text class="title">{{title}}</text>
    <view wx:for="{{questions}}" wx:key="_id" class="panel">
      <text class="panel-title">{{index + 1}}. {{item.prompt}}</text>
      <text class="description">参考: {{item.expectedAnswer}}</text>
    </view>
    <button class="primary-action" loading="{{submitting}}" bindtap="submitQuiz">提交 mock 答案</button>
  </block>
</view>
