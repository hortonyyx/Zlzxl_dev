.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f6f7f9;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.description {
  display: block;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.primary-action {
  border-radius: 12rpx;
  background: #111827;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}
