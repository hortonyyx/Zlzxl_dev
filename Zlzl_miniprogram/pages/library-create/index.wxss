.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f6f7f9;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.description {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.mode,
.input,
.upload-placeholder {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.active {
  border: 2rpx solid #111827;
}

.disabled {
  opacity: 0.56;
}

.mode-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.input {
  height: 88rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.upload-placeholder {
  color: #6b7280;
  font-size: 26rpx;
}

.primary-action {
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}
