.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f6f7f9;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.description {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.item {
  display: block;
  margin-top: 12rpx;
  color: #374151;
  font-size: 26rpx;
}

.point {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.green {
  color: #16a34a;
}

.yellow {
  color: #d97706;
}

.gray {
  color: #6b7280;
}

.primary-action,
.secondary-action {
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.primary-action {
  background: #111827;
  color: #ffffff;
}

.secondary-action {
  background: #e5e7eb;
  color: #111827;
}
